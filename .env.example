# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# Database (see cpad/ControlPadDB.php) - omit any of these to fall back to
# local XAMPP defaults (root / no password / localhost).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sonnaclankaenterprises
DB_USER=root
DB_PASSWORD=

# S3 file storage (see cpad/clsS3Storage.php) - vehicle images, review
# photos, staff avatars and vehicle documents are uploaded here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Folder inside the bucket this project's uploads live under - keeps
# multiple projects sharing one bucket from colliding.
AWS_STORAGE_FOLDER=sonnaclankaenterprises
